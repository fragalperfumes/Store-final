<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light">
<title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
{% render 'meta-tags' %}
{{ content_for_header }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Cormorant+Garamond:wght@500;600&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Manrope:wght@400;600;700;800&family=Noto+Nastaliq+Urdu:wght@400&display=swap" rel="stylesheet">
{{ 'base.css' | asset_url | stylesheet_tag }}
{% if template.name == 'index' %}<link rel="preload" as="image" media="(min-width: 701px)" href="{{ 'hero-zaran-768w-v16.webp' | asset_url }}" imagesrcset="{{ 'hero-zaran-480w-v16.webp' | asset_url }} 480w, {{ 'hero-zaran-768w-v16.webp' | asset_url }} 768w, {{ 'hero-zaran-941x1672-v1.webp' | asset_url }} 941w, {{ 'hero-zaran-1400x2000-v1.webp' | asset_url }} 1400w" imagesizes="(max-width: 1080px) 92vw, 560px" fetchpriority="high"><link rel="preload" as="image" media="(max-width: 700px)" href="{{ 'hero-zaran-mobile-1280x720-v2.webp' | asset_url }}" fetchpriority="high">{% endif %}
<style>:root{--green:{{ settings.color_green }};--green-2:{{ settings.color_green }};--gold:{{ settings.color_gold }};--gold-2:#9c7c2e;--gold-deep:#a8823f}</style>
<link rel="icon" type="image/png" href="https://cdn.shopify.com/s/files/1/0605/7299/1568/files/Golden_Perfume_Bottle_Monogram.png?v=1793825750">
</head>
<body>
{% section 'announcement-bar' %}
{% section 'header' %}
<main id="MainContent" role="main">{{ content_for_layout }}</main>
{% section 'footer' %}
{% section 'cart-drawer' %}
<div class="toast" id="themeToast" role="status"></div>
<script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>

{% assign prod = section.settings.product %}
{% if prod == blank %}{% assign prod = collections.all.products.first %}{% endif %}
<section id="shop" class="screen">
  <div class="bestseller-head">
    <div class="sec-head">
      <h2>{{ section.settings.heading }}</h2>
      <div class="gold-rule"></div>
    </div>
  </div>
  <div class="wrap">
    <article class="pcard">
      <div class="pcard-media">
        <span class="pcard-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.6 3.6 21 12l-9 9-8.4-8.4A2 2 0 0 1 3 11.2V4a1 1 0 0 1 1-1h7.2a2 2 0 0 1 1.4.6Z"/><circle cx="7.5" cy="7.5" r="1.3"/></svg> 38% OFF</span>
        <a href="{% if prod %}{{ prod.url }}{% else %}#shop{% endif %}" aria-label="Open the ZARAN 50ML product page">
          {% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url: width: 900 }}" alt="ZARAN 50ML perfume bottle" loading="lazy">
          {% elsif prod.featured_image %}<img src="{{ prod.featured_image | image_url: width: 900 }}" alt="{{ prod.title | escape }}" loading="lazy">
          {% else %}<img src="{{ 'zaran-luxury-web.webp' | asset_url }}" alt="ZARAN 50ML perfume bottle — golden amber faceted glass, diamond-cut crystal cap, white FRAGAL PERFUMES and ZARAN print, on a light studio background with a soft reflection" loading="lazy">{% endif %}
          {% if section.settings.hover_image != blank %}<img class="pcard-img-hover" src="{{ section.settings.hover_image | image_url: width: 900 }}" alt="" aria-hidden="true" loading="lazy">
          {% else %}<img class="pcard-img-hover" src="{{ 'card-hover-set.webp' | asset_url }}" alt="" aria-hidden="true" loading="lazy">{% endif %}
        </a>
      </div>
      <div class="pcard-body">
        <h3 class="pcard-name">{% if prod %}{{ prod.title }}{% else %}ZARAN 50ML{% endif %}</h3>
        <div class="pcard-price">
          <span class="now">{% if prod %}{{ prod.price | money }}{% else %}Rs. 2,499.00{% endif %}</span>
          <span class="was">{% if prod and prod.compare_at_price > prod.price %}{{ prod.compare_at_price | money }}{% else %}Rs. 3,999.00{% endif %}</span>
        </div>
        <div class="pcard-stars" role="img" aria-label="5 gold stars"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></div>
        <button class="btn pcard-add" type="button" data-add-to-cart {% if prod %}data-variant-id="{{ prod.selected_or_first_available_variant.id }}"{% endif %}>ADD TO CART</button>
        <button class="btn pcard-buy" type="button" data-add-to-cart {% if prod %}data-variant-id="{{ prod.selected_or_first_available_variant.id }}"{% endif %}>BUY NOW</button>
      </div>
    </article>
  </div>
</section>
{% schema %}
{ "name": "Featured product — ZARAN", "settings": [
  { "type": "product", "id": "product", "label": "Product" },
  { "type": "image_picker", "id": "image", "label": "Card photo" },
  { "type": "image_picker", "id": "hover_image", "label": "Card hover photo (bottle + box)" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "BEST SELLER PERFUME" }
], "presets": [{ "name": "Featured product — ZARAN" }] }
{% endschema %}

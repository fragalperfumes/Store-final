<div class="page-wrap">
  <h1>{{ article.title }}</h1>
  <p style="color:var(--muted2);font-size:13px;margin-bottom:20px">{{ article.published_at | date: '%d %B %Y' }}</p>
  {% if article.image %}<img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.title | escape }}" style="border-radius:20px;margin-bottom:24px">{% endif %}
  <div class="rte">{{ article.content }}</div>
</div>
{% schema %}{ "name": "Main article", "settings": [] }{% endschema %}

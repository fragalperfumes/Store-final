{% assign prod = product %}
{% assign fixed_gallery = false %}{% if prod.handle == 'zaran' or prod.handle == 'zaran-50ml' %}{% assign fixed_gallery = true %}{% endif %}
<section aria-label="{{ prod.title | escape }} — product page">
  <div class="pd-wrap">
    <div class="pd-top">
      <a class="pd-back" href="{{ routes.root_url }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6"/></svg>
        Back
      </a>
      <nav class="pd-crumb" aria-label="Breadcrumb">Home &nbsp;/&nbsp; Shop All &nbsp;/&nbsp; <b>{{ prod.title }}</b></nav>
    </div>
    <div class="pd-grid">
      <div class="pd-gallery">
        <div class="pd-stage">
          <span class="pd-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.6 3.6 21 12l-9 9-8.4-8.4A2 2 0 0 1 3 11.2V4a1 1 0 0 1 1-1h7.2a2 2 0 0 1 1.4.6Z"/><circle cx="7.5" cy="7.5" r="1.3"/></svg> 38% OFF</span>
          {% if fixed_gallery %}
            <img id="pdMainImg" src="{{ 'zaran-pdp-white-bottle-v1.webp' | asset_url }}" alt="ZARAN 50ML perfume bottle — golden amber faceted glass with diamond-cut crystal cap and white FRAGAL PERFUMES ZARAN print, on a light studio background">
          {% elsif prod.images.size > 0 %}
            <img id="pdMainImg" src="{{ prod.images.first | image_url: width: 1200 }}" alt="{{ prod.title | escape }}">
          {% else %}
            <img id="pdMainImg" src="{{ 'zaran-pdp-white-bottle-v1.webp' | asset_url }}" alt="ZARAN 50ML perfume bottle — golden amber faceted glass with diamond-cut crystal cap and white FRAGAL PERFUMES ZARAN print, on a light studio background">
          {% endif %}
        </div>
        <div class="pd-thumbs" role="group" aria-label="Product photos">
          {% if fixed_gallery or prod.images.size == 0 %}
            <button class="pd-thumb on" type="button" data-pd-src="{{ 'zaran-pdp-white-bottle-v1.webp' | asset_url }}" data-pd-alt="ZARAN 50ML perfume bottle — golden amber faceted glass with diamond-cut crystal cap and white FRAGAL PERFUMES ZARAN print, on a light studio background" aria-label="Photo 1 — bottle only">
              <img src="{{ 'zaran-pdp-white-bottle-v1.webp' | asset_url }}" alt="" loading="lazy">
            </button>
            <button class="pd-thumb" type="button" data-pd-src="{{ 'zaran-pdp-box-set-v1.webp' | asset_url }}" data-pd-alt="ZARAN 50ML golden bottle with the black FRAGAL PERFUMES gift box" aria-label="Photo 2 — bottle and box">
              <img src="{{ 'zaran-pdp-box-set-v1.webp' | asset_url }}" alt="" loading="lazy">
            </button>
            <button class="pd-thumb" type="button" data-pd-src="{{ 'zaran-pdp-driftwood-900w-v17.webp' | asset_url }}" data-pd-alt="ZARAN 50ML golden amber bottle standing among driftwood pieces in warm amber light" aria-label="Photo 3 — bottle among driftwood">
              <img src="{{ 'zaran-pdp-driftwood-450w-v17.webp' | asset_url }}" srcset="{{ 'zaran-pdp-driftwood-450w-v17.webp' | asset_url }} 450w, {{ 'zaran-pdp-driftwood-900w-v17.webp' | asset_url }} 900w" sizes="96px" alt="" loading="lazy">
            </button>
          {% else %}
            {% for image in prod.images %}
            <button class="pd-thumb{% if forloop.first %} on{% endif %}" type="button" data-pd-src="{{ image | image_url: width: 1200 }}" data-pd-alt="{{ image.alt | escape }}" aria-label="Photo {{ forloop.index }}">
              <img src="{{ image | image_url: width: 300 }}" alt="" loading="lazy">
            </button>
            {% endfor %}
          {% endif %}
        </div>
      </div>
      <div class="pd-info">
        <h1>{{ prod.title }}</h1>
        <div class="pd-stars" role="img" aria-label="5 gold stars"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></div>
        <div class="pd-price">
          <span class="now" id="productPrice">{{ prod.price | money }}</span>
          {% if prod.compare_at_price > prod.price %}<span class="was">{{ prod.compare_at_price | money }}</span>{% endif %}
        </div>
        {% if prod.compare_at_price > prod.price %}
          {% assign save_amt = prod.compare_at_price | minus: prod.price %}
          {% assign save_pct = save_amt | times: 100.0 | divided_by: prod.compare_at_price | round %}
          <div class="pd-save">Save {{ save_amt | money }} ({{ save_pct }}% OFF)</div>
        {% endif %}
        <div class="stock pd-stock"><i></i>{% if prod.available %}In stock, ready to ship{% else %}Out of stock{% endif %}</div>
        {% if prod.has_only_default_variant == false %}
          <select class="variant-select" id="variantSelect" aria-label="Variant">
            {% for variant in prod.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}
          </select>
        {% endif %}
        <button class="btn pcard-add" type="button" data-add-to-cart data-variant-id="{{ prod.selected_or_first_available_variant.id }}">ADD TO CART</button>
        <button class="btn pcard-buy" type="button" data-add-to-cart data-variant-id="{{ prod.selected_or_first_available_variant.id }}">BUY NOW</button>
        <div class="pd-desc">
          <h3>ZARAN — wear gold.</h3>
          <p>Some perfumes fade by noon. ZARAN doesn't. This is Fragal's signature 50ml scent — deep, warm and unmistakably present, made for evenings, events and anyone who wants to be remembered in the room.</p>
          <h3>WHY YOU'LL LOVE IT</h3>
          <ul>
            <li>Long-lasting wear — one application in the morning carries you through the day</li>
            <li>A bold, luxurious scent profile</li>
            <li>Premium 50ml bottle with gold detailing — gift-ready in the black Fragal box</li>
            <li>Made in Pakistan, shipped across the country</li>
          </ul>
          <h3>PERFORMANCE</h3>
          <ul>
            <li>Concentration: 40%</li>
            <li>Lasting: up to 8+ hours (sprayed on clothes)</li>
          </ul>
          <h3>HOW TO USE</h3>
          <p>Spray ZARAN on your clothes — collar, chest or sleeves — not directly on skin. Do not rub; let it settle.</p>
          <h3>SHIPPING INFORMATION</h3>
          <ul>
            <li>Cash on Delivery available across Pakistan</li>
            <li>Free shipping on orders over Rs. 4,000</li>
            <li>Delivery: 3–5 days</li>
          </ul>
          <h3>WHAT'S IN THE BOX</h3>
          <ul>
            <li>1 × ZARAN 50ml perfume bottle</li>
            <li>1 × FREE new perfume 5ml tester</li>
            <li>Fragal gift box and bag</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}{ "name": "Main product", "settings": [] }{% endschema %}

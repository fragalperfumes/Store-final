<section id="reviews" class="screen">
  <div class="sec-head">
    <h2>{{ section.settings.heading }}</h2>
    <div class="gold-rule"></div>
  </div>
  <div class="wrap">
    <div class="reviews">
      <div class="rev-viewport">
        <div class="rev-track" id="revTrack">
          {% for block in section.blocks %}
          <article class="rev-card" {{ block.shopify_attributes }}>
            <div class="rev-card-in">
              <div class="rev-stars" role="img" aria-label="Rated 5 out of 5 stars"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></div>
              <p class="rev-text">{{ block.settings.text }}</p>
              <div class="rev-prod">ZARAN 50ML</div>
              <div class="rev-name">{{ block.settings.name }}</div>
            </div>
          </article>
          {% endfor %}
        </div>
      </div>
      <div class="rev-dots" id="revDots" aria-label="Reviews — choose a slide"></div>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Reviews", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "From our customers" }
], "blocks": [
  { "type": "review", "name": "Review", "settings": [
    { "type": "textarea", "id": "text", "label": "Review text" },
    { "type": "text", "id": "name", "label": "Reviewer name" }
  ] }
], "presets": [{ "name": "Reviews" }] }
{% endschema %}

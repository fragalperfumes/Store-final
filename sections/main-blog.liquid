<div class="page-wrap" style="max-width:1100px">
  <h1>{{ blog.title }}</h1>
  <div class="collection-grid" style="margin-top:26px">
    {% for article in blog.articles %}
    <div class="p-card">
      <a href="{{ article.url }}">{% if article.image %}<img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}">{% endif %}</a>
      <div class="p-body"><h3><a href="{{ article.url }}">{{ article.title }}</a></h3><p style="color:var(--muted);font-size:14px;margin-top:8px;line-height:1.6">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p></div>
    </div>
    {% endfor %}
  </div>
</div>
{% schema %}{ "name": "Main blog", "settings": [] }{% endschema %}

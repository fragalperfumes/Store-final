<div class="page-wrap" style="text-align:center">
  <img src="{{ 'fragal-logo-v15.png' | asset_url }}" alt="FRAGAL PERFUMES" style="width:200px;margin:0 auto 20px">
  <h1>{{ shop.name }}</h1>
  <p class="rte">Opening soon — Scents That Stay.</p>
  {% form 'storefront_password' %}
    {% if form.errors %}<div class="form-error">{{ form.errors.translated_fields.password }} {{ form.errors.messages.password }}</div>{% endif %}
    <input class="shopify-input" type="password" name="password" placeholder="Password" aria-label="Password" style="max-width:340px;margin:18px auto 12px">
    <button class="btn btn-gold" type="submit">ENTER</button>
  {% endform %}
</div>
{% schema %}{ "name": "Main password", "settings": [] }{% endschema %}

<section id="{{ section.settings.page_anchor }}" aria-label="{{ section.settings.crumb | escape }}">
  <div class="pd-wrap">
    <div class="pd-top">
      <a class="pd-back" href="{{ routes.root_url }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6"/></svg>
        Back
      </a>
      <nav class="pd-crumb" aria-label="Breadcrumb">Home &nbsp;/&nbsp; <b>{{ section.settings.crumb }}</b></nav>
    </div>
    {{ section.settings.head_html }}
    {{ section.settings.body_html }}
  </div>
</section>
{% schema %}
{ "name": "Fragal page", "settings": [
  { "type": "text", "id": "page_anchor", "label": "Page anchor id (CSS scoping)" },
  { "type": "text", "id": "crumb", "label": "Breadcrumb label" },
  { "type": "html", "id": "head_html", "label": "Heading HTML" },
  { "type": "html", "id": "body_html", "label": "Body HTML" }
], "presets": [{ "name": "Fragal page" }] }
{% endschema %}
